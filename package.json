{
  "name": "terminology-sdk-front-ts",
  "version": "0.1.0",
  "description": "Framework-neutral browser cache and local search for terminology catalogs",
  "author": "Connecting Solution & Applications Ltd. (ConnectHealth.info)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Global-DataCare/terminology-sdk-front-ts.git"
  },
  "type": "module",
  "engines": { "node": ">=24" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./browser-client": { "types": "./dist/browser-client.d.ts", "default": "./dist/browser-client.js" },
    "./indexeddb-store": { "types": "./dist/indexeddb-store.d.ts", "default": "./dist/indexeddb-store.js" }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "terminology-data-utils-ts": "0.2.0",
    "terminology-sdk-core-ts": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
